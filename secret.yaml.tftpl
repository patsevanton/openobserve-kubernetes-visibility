apiVersion: v1
kind: Secret
metadata:
  name: openobserve-secrets
  namespace: openobserve
  labels:
    app.kubernetes.io/name: openobserve
    app.kubernetes.io/component: secrets
type: Opaque
stringData:
  # Root-пользователь OpenObserve (вход в UI)
  ZO_ROOT_USER_EMAIL: "${openobserve_root_user_email}"
  ZO_ROOT_USER_PASSWORD: "${openobserve_root_user_password}"
  # Static access key Yandex Object Storage (создаётся terraform'ом, см. openobserve.tf)
  ZO_S3_ACCESS_KEY: "${openobserve_s3_access_key}"
  ZO_S3_SECRET_KEY: "${openobserve_s3_secret_key}"
  # Managed PostgreSQL (создаётся terraform'ом, см. postgres.tf): special FQDN
  # c-<cluster_id>.rw... — текущий master (запись), c-<cluster_id>.ro... — самая
  # свежая replica (чтение). Порт 6432; трафик внутри cloud-сети, sslmode=disable
  ZO_META_POSTGRES_DSN: "${openobserve_postgres_dsn}"
  ZO_META_POSTGRES_RO_DSN: "${openobserve_postgres_ro_dsn}"
